def B32.hex_u32(+a0: U32, +a1: U32, +a2: U32, +a3: U32, +a4: U32, +a5: U32, +a6: U32, +a7: U32)
  -> {S.Hex.read_b32(S.Hex.b32(S.B32{a0, a1, a2, a3, a4, a5, a6, a7})) == Some{S.B32{a0, a1, a2, a3, a4, a5, a6, a7}} : Maybe<&2, S.B32>}:
  match a0 a1 a2 a3 a4 a5 a6 a7:
    case U32{w0} U32{w1} U32{w2} U32{w3} U32{w4} U32{w5} U32{w6} U32{w7}:
      B32.hex_words(w0, w1, w2, w3, w4, w5, w6, w7)

def B32.hex_rt(+x: S.B32) -> {S.Hex.read_b32(S.Hex.b32(x)) == Some{x} : Maybe<&2, S.B32>}:
  match x:
    case S.B32{a0, a1, a2, a3, a4, a5, a6, a7}:
      B32.hex_u32(a0, a1, a2, a3, a4, a5, a6, a7)
