# Lemmas for the hex law b32_hex and for the log laws. A hex digit holds 4
# bits of a word, low bit first. Hex.ws writes the digits of a word from the
# low digit up, each in front of the string so far, and Hex.rd reads them
# high digit first, each in front of the bits so far.
import Base
import ../src/ssz.bend as S
import ./lemmas.bend as Lm
import ./num.bend as N

# A digit reads back as its 4 bits.
def Nib.rt(b0: Bool, b1: Bool, b2: Bool, b3: Bool) -> {S.Hex.bits(S.Hex.nib(b0, b1, b2, b3)) == Some{[b0, b1, b2, b3]} : Maybe<&2, List<&2, Bool>>}:
  match b0 b1 b2 b3:
    case False{} False{} False{} False{}:
      {==}
    case True{} False{} False{} False{}:
      {==}
    case False{} True{} False{} False{}:
      {==}
    case True{} True{} False{} False{}:
      {==}
    case False{} False{} True{} False{}:
      {==}
    case True{} False{} True{} False{}:
      {==}
    case False{} True{} True{} False{}:
      {==}
    case True{} True{} True{} False{}:
      {==}
    case False{} False{} False{} True{}:
      {==}
    case True{} False{} False{} True{}:
      {==}
    case False{} True{} False{} True{}:
      {==}
    case True{} True{} False{} True{}:
      {==}
    case False{} False{} True{} True{}:
      {==}
    case True{} False{} True{} True{}:
      {==}
    case False{} True{} True{} True{}:
      {==}
    case True{} True{} True{} True{}:
      {==}

def Rd.list(+q: Nat, +j: Nat, +s: String, +acc: List<&2, Bool>, +b0: Bool, +b1: Bool, +b2: Bool, +b3: Bool, +t: Word(Nat.mul(q, 4n)))
  -> {S.Hex.rd(1n+j, SCon{S.Hex.nib(b0, b1, b2, b3), s}, List.append(&2, Bool, S.Word.to_list(Nat.mul(q, 4n), t), acc)) == S.Hex.rd(j, s, List.append(&2, Bool, S.Word.to_list(Nat.mul(1n+q, 4n), WCon{b0, WCon{b1, WCon{b2, WCon{b3, t}}}}), acc)) : Maybe<&2, S.HexRd>}:
  %Equal.sym(Maybe<&2, List<&2, Bool>>, S.Hex.bits(S.Hex.nib(b0, b1, b2, b3)), Some{[b0, b1, b2, b3]}, Nib.rt(b0, b1, b2, b3)) : {Maybe.bind(&2, List<&2, Bool>, S.HexRd, _, k => S.Hex.rd(j, s, List.append(&2, Bool, k, List.append(&2, Bool, S.Word.to_list(Nat.mul(q, 4n), t), acc)))) == S.Hex.rd(j, s, List.append(&2, Bool, S.Word.to_list(Nat.mul(1n+q, 4n), WCon{b0, WCon{b1, WCon{b2, WCon{b3, t}}}}), acc)) : Maybe<&2, S.HexRd>}
  {==}

# Reading the digits that ws wrote gives the bits back, low bit first.
def Rd.ws(g: Nat, +j: Nat, w: Word(Nat.mul(g, 4n)), +s: String, +acc: List<&2, Bool>)
  -> {S.Hex.rd(Nat.add(g, j), S.Hex.ws(g, w, s), acc) == S.Hex.rd(j, s, List.append(&2, Bool, S.Word.to_list(Nat.mul(g, 4n), w), acc)) : Maybe<&2, S.HexRd>}:
  match g:
    case 0n:
      match w:
        case WNil{}:
          {==}
    case 1n+q0:
      match w:
        case WCon{+b0, t0}:
          match t0:
            case WCon{+b1, t1}:
              match t1:
                case WCon{+b2, t2}:
                  match t2:
                    case WCon{+b3, +t}:
                      +q = q0
                      %N.Add.succ_r(q, j) : {S.Hex.rd(_, S.Hex.ws(q, t, SCon{S.Hex.nib(b0, b1, b2, b3), s}), acc) == S.Hex.rd(j, s, List.append(&2, Bool, S.Word.to_list(Nat.mul(1n+q, 4n), WCon{b0, WCon{b1, WCon{b2, WCon{b3, t}}}}), acc)) : Maybe<&2, S.HexRd>}
                      %Equal.sym(Maybe<&2, S.HexRd>, S.Hex.rd(Nat.add(q, 1n+j), S.Hex.ws(q, t, SCon{S.Hex.nib(b0, b1, b2, b3), s}), acc), S.Hex.rd(1n+j, SCon{S.Hex.nib(b0, b1, b2, b3), s}, List.append(&2, Bool, S.Word.to_list(Nat.mul(q, 4n), t), acc)), Rd.ws(q, 1n+j, t, SCon{S.Hex.nib(b0, b1, b2, b3), s}, acc)) : {_ == S.Hex.rd(j, s, List.append(&2, Bool, S.Word.to_list(Nat.mul(1n+q, 4n), WCon{b0, WCon{b1, WCon{b2, WCon{b3, t}}}}), acc)) : Maybe<&2, S.HexRd>}
                      Rd.list(q, j, s, acc, b0, b1, b2, b3, t)

# A word of a list starts with the bits of w.
def Of_list.app(n: Nat, w: Word(n), +r: List<&2, Bool>) -> {S.Word.of_list(n, List.append(&2, Bool, S.Word.to_list(n, w), r)) == w : Word(n)}:
  match n:
    case 0n:
      match w:
        case WNil{}:
          {==}
    case 1n+p:
      match w:
        case WCon{+b, +t}:
          +q = p
          Equal.cong(Word(q), Word(1n+q), y => WCon{b, y}, S.Word.of_list(q, List.append(&2, Bool, S.Word.to_list(q, t), r)), t, Of_list.app(q, t, r))

def Drop.app(n: Nat, w: Word(n), +r: List<&2, Bool>, +k: Nat) -> {List.drop(&2, Bool, List.append(&2, Bool, S.Word.to_list(n, w), r), Nat.add(n, k)) == List.drop(&2, Bool, r, k) : List<&2, Bool>}:
  match n:
    case 0n:
      match w:
        case WNil{}:
          {==}
    case 1n+p:
      match w:
        case WCon{b, t}:
          Drop.app(p, t, r, k)

def Drop.zero(xs: List<&2, Bool>) -> {List.drop(&2, Bool, xs, 0n) == xs : List<&2, Bool>}:
  match xs:
    case Nil{}:
      {==}
    case Con{x, t}:
      {==}

def U32.of_list.here(+w: Word(32n), +r: List<&2, Bool>) -> {S.U32.of_list(List.append(&2, Bool, S.Word.to_list(32n, w), r), 0n) == U32{w} : U32}:
  %Equal.sym(List<&2, Bool>, List.drop(&2, Bool, List.append(&2, Bool, S.Word.to_list(32n, w), r), 0n), List.append(&2, Bool, S.Word.to_list(32n, w), r), Drop.zero(List.append(&2, Bool, S.Word.to_list(32n, w), r))) : {U32{S.Word.of_list(32n, _)} == U32{w} : U32}
  Equal.cong(Word(32n), U32, y => U32{y}, S.Word.of_list(32n, List.append(&2, Bool, S.Word.to_list(32n, w), r)), w, Of_list.app(32n, w, r))

def U32.of_list.skip(+w: Word(32n), +r: List<&2, Bool>, +i: Nat) -> {S.U32.of_list(List.append(&2, Bool, S.Word.to_list(32n, w), r), 1n+i) == S.U32.of_list(r, i) : U32}:
  Equal.cong(List<&2, Bool>, U32, y => U32{S.Word.of_list(32n, y)}, List.drop(&2, Bool, List.append(&2, Bool, S.Word.to_list(32n, w), r), Nat.add(32n, Nat.mul(i, 32n))), List.drop(&2, Bool, r, Nat.mul(i, 32n)), Drop.app(32n, w, r, Nat.mul(i, 32n)))

